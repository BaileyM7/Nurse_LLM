# Copy this file to secrets.toml and fill in your API key(s)
# On Streamlit Cloud, add these in the app settings under "Secrets"

# Choose the LLM provider: "openai" or "gemini"
LLM_PROVIDER = "openai"

# Only the provider you select needs a key — the other can be left blank
OPENAI_API_KEY = "sk-your-openai-key-here"
GEMINI_API_KEY = "your-gemini-key-here"
