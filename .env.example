# Choose the LLM provider: "openai" or "gemini"
LLM_PROVIDER=openai

# OpenAI credentials + models (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_FEEDBACK_MODEL=gpt-4o

# Gemini credentials + models (required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL_NAME=gemini-2.5-flash
GEMINI_FEEDBACK_MODEL=gemini-2.5-flash

DATABASE_URL=sqlite:///./data/nurse_llm.db
SCENARIOS_DIR=./data/scenarios
MAX_TURNS=30
